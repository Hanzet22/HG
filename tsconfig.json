{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "shared/**/*.ts",
    "*.js"
  ],
  "exclude": [
    "node_modules",
    "HyperGaruda-Next"
  ]
}